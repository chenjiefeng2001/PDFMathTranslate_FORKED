 {
  "node_id": "p69_16",
  "index": 16,
  "text": "Figure 0-28: Encapsulating a readily extensible collection (BAD IDEA)",
  "bbox": [
   187.64239,
   261.6641,
   460.35319,
   270.6641
  ],
  "font": "HAKKMC+TimesLTPro-Bold",
