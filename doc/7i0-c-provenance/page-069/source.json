  "translation_status": "translated"
 },
 {
  "node_id": "p69_17",
  "index": 17,
  "text": "As will be a recurring theme throughout this book, we will choose to avoid encapsulating\ninherently extensible, nonportable, third-party, or otherwise uncontrollable or risky software\nthat could potentially produce a destabilizing effect on our core libraries. Instead, we will",
  "bbox": [
   134.5,
   207.44499000000002,
   513.5059999999999,
   245.44499000000002
  ],
  "font": "HAKIBM+TimesLTPro-Roman",
