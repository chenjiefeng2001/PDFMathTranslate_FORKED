  "line_count": 1,
  "translation_status": "translated"
 },
 {
  "node_id": "p185_20",
  "index": 20,
  "text": "file will not expose this problem: The compiler will see each of the functions defined in the\n.cpp file as distinct entities from those declared in the corresponding .h file. Such mismatches\nin signatures between declaration and definition will go undetected at compile time (and, if\nthese pure declarations go unused, at link time as well). We can, however, ensure that the\ncompiler will report such defects — simply by defining the entity from outside of the scope in\nwhich it is declared — as shown in Figure 1-17.",
  "bbox": [
   134.49858999999998,
   217.63228999999998,
   513.50259,
   297.63219999999995
  ],
  "font": "HAKIBM+TimesLTPro-Roman",
  "font_size": 10.0,
  "line_count": 6,
  "translation_status": "preserved"
 },
 {
