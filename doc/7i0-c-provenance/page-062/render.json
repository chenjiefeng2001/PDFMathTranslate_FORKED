   ]
  },
  {
   "pdf_object_id": "text:53",
   "operator": "TJ",
   "text": "as the “upgrade” is substantially backward-compatible (Volume II, section 5.5), it is not unreasonable to expect that ",
   "bbox": [
    93.97,
    554.87,
    468.71,
    562.87
   ],
   "font": "TimesLTPro-Roman",
   "font_size": 8.0,
