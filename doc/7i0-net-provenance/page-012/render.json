  },
  {
   "pdf_object_id": "text:61",
   "operator": "TJ",
   "text": "带领我们讨论了可能在不久的将来影响游",
   "bbox": [
    227.37,
    465.5,
    411.18,
    480.17
   ],
   "font": "SourceHanSerifCN-Regular",
   "font_size": 10.21,
