    211.85
   ]
  },
  {
   "pdf_object_id": "text:63",
   "operator": "TJ",
   "text": " ISP ",
   "bbox": [
    291.16,
    480.79,
    311.02,
    494.41
   ],
   "font": "Times-Roman",
   "font_size": 10.21,
   "color": 0,
   "line": 27,
   "page": 25,
   "block_type": 0,
   "v3_bbox": [
    291.16,
    197.24,
    311.02,
    210.86
   ]
  },
  {
   "pdf_object_id": "text:64",
   "operator": "TJ",
   "text": "服务中的拥塞点；它们",
   "bbox": [
    311.02,
    479.8,
    413.14,
    494.46
   ],
   "font": "SourceHanSerifCN-Regular",
   "font_size": 10.21,
   "color": 0,
   "line": 27,
   "page": 25,
   "block_type": 0,
   "v3_bbox": [
    311.02,
    197.19,
    413.14,
    211.85
   ]
  },
  {
   "pdf_object_id": "text:65",
   "operator": "TJ",
   "text": "采用多种技术，支持固定和无线连接，并具有独特的延迟和损耗特性。我们从高层",
   "bbox": [
    46.08,
    494.09,
    413.7,
    508.76
   ],
   "font": "SourceHanSerifCN-Regular",
   "font_size": 10.21,
   "color": 0,
   "line": 28,
   "page": 25,
   "block_type": 0,
   "v3_bbox": [
    46.08,
    182.89,
    413.7,
    197.56
   ]
  },
  {
   "pdf_object_id": "text:66",
   "operator": "TJ",
   "text": "次上回顾了电缆调制解调器、非对称数字用户线路",
   "bbox": [
    46.08,
    508.39,
    270.74,
