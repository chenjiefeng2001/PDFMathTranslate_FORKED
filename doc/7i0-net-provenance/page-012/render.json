    226.15
   ]
  },
  {
   "pdf_object_id": "text:62",
   "operator": "TJ",
   "text": "戏玩家体验的各种宽带接入技术。接入网络通常是现代",
   "bbox": [
    46.08,
    479.8,
    291.16,
    494.46
   ],
   "font": "SourceHanSerifCN-Regular",
   "font_size": 10.21,
   "color": 0,
   "line": 27,
   "page": 25,
   "block_type": 0,
   "v3_bbox": [
    46.08,
