    226.15
   ]
  },
  {
   "pdf_object_id": "text:60",
   "operator": "TJ",
   "text": "Philip Branch ",
   "bbox": [
    168.37,
    466.49,
    227.37,
    480.12
   ],
   "font": "Times-Roman",
   "font_size": 10.21,
   "color": 0,
